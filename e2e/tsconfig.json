{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "mocha", "@wdio/globals/types"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
